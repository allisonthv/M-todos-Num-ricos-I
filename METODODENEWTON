    "# Generar gráfica para ilustrar el comportamiento de la función y la raíz encontrada\n",
    "x_vals = np.linspace(1.0, 2.0, 400)\n",
    "y_vals = f(x_vals)\n",
    "\n",
    "plt.figure(figsize=(8, 5))\n",
    "plt.plot(x_vals, y_vals, label='$f(x) = x^3 - x - 2$', color='blue')\n",
    "plt.axhline(0, color='black', linewidth=0.8, linestyle='--')\n",
    "plt.scatter([raiz_aproximada], [f(raiz_aproximada)], color='red', zorder=5, label=f'Raíz aproximada: {raiz_aproximada:.5f}')\n",
    "plt.title('Método de Newton')\n",
    "plt.xlabel('$x$')\n",
    "plt.ylabel('$f(x)$')\n",
    "plt.grid(True, linestyle=':', alpha=0.6)\n",
    "plt.legend()\n",
    "plt.show()"
   ]
