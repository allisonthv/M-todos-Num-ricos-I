    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "def metodo_newton(f, df, p0, tol, N0):\n",
    "    \"\"\"\n",
    "    Implementación del Algoritmo 2.3 (Método de Newton) de Burden & Faires.\n",
    "    \n",
    "    Parámetros:\n",
    "    - f: Función de la cual se busca la raíz.\n",
    "    - df: Derivada de la función f.\n",
    "    - p0: Aproximación inicial.\n",
    "    - tol: Tolerancia para el criterio de paro.\n",
    "    - N0: Número máximo de iteraciones.\n",
    "    \n",
    "    Retorna:\n",
    "    - p: Aproximación final de la raíz.\n",
    "    \"\"\"\n",
    "    i = 1\n",
    "    print(f\"{'i':<5} {'p_i':<15} {'f(p_i)':<15}\")\n",
    "    print(\"-\" * 35)\n",
    "    \n",
    "    while i <= N0:\n",
    "        # Calcular p usando la fórmula de Newton\n",
    "        # Evitamos división por cero evaluando df(p0)\n",
    "        derivada = df(p0)\n",
    "        if derivada == 0:\n",
    "            raise ValueError(\"Derivada cero en la iteración. El método falla.\")\n",
    "            \n",
    "        p = p0 - f(p0) / derivada\n",
    "        \n",
    "        print(f\"{i:<5} {p:<15.8f} {f(p):<15.8e}\")\n",
    "        \n",
    "        # Criterio de convergencia\n",
    "        if abs(p - p0) < tol:\n",
    "            print(\"-\" * 35)\n",
    "            print(f\"\\n¡Éxito! El método convergió a la raíz p = {p:.8f} en {i} iteraciones.\")\n",
    "            return p\n",
    "            \n",
    "        i += 1\n",
    "        p0 = p\n",
    "        \n",
    "    print(f\"\\nSe excedió el número máximo de iteraciones ({N0}).\")\n",
    "    return None\n",
    "\n",
    "# Definición del Ejemplo 1 (Libro de Burden)\n",
    "# Queremos encontrar una solución para f(x) = x^3 - x - 2 = 0\n",
    "def f(x):\n",
    "    return x**3 - x - 2\n",
    "\n",
    "def df(x):\n",
    "    return 3*x**2 - 1\n",
    "\n",
    "# Parámetros iniciales según el ejemplo o análisis gráfico\n",
    "p0 = 1.0  # Aproximación inicial\n",
    "tol = 1e-5  # Tolerancia\n",
    "N0 = 20   # Máximo de iteraciones\n",
    "\n",
    "# Ejecución del algoritmo\n",
    "raiz_aproximada = metodo_newton(f, df, p0, tol, N0)"
   ]
