    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "def neville_algoritmo_3_1(x_eval: float, x_nodes: list | np.ndarray, y_nodes: list | np.ndarray) -> tuple[np.ndarray, float]:\n",
    "    \"\"\"\n",
    "    Implementación del Algoritmo 3.1 (Interpolación iterada de Neville) de Burden.\n",
    "\n",
    "    Parámetros\n",
    "    ----------\n",
    "    x_eval : float\n",
    "        Punto x en el que se desea evaluar el polinomio de interpolación.\n",
    "    x_nodes : list | np.ndarray\n",
    "        Lista o arreglo con los n + 1 nodos distintos [x_0, x_1, ..., x_n].\n",
    "    y_nodes : list | np.ndarray\n",
    "        Valores correspondientes de la función [f(x_0), f(x_1), ..., f(x_n)].\n",
    "\n",
    "    Retorna\n",
    "    -------\n",
    "    Q : np.ndarray\n",
    "        Tabla triangular inferior de tamaño (n + 1) x (n + 1) con las aproximaciones Q_{i,j}.\n",
    "    aproximacion_final : float\n",
    "        Valor Q_{n,n}, correspondiente a la última entrada de la tabla.\n",
    "    \"\"\"\n",
    "    # Convertimos las entradas a arreglos NumPy de punto flotante para operaciones vectoriales/numéricas\n",
    "    x_arr = np.asarray(x_nodes, dtype=float)\n",
    "    y_arr = np.asarray(y_nodes, dtype=float)\n",
    "\n",
    "    # Validación básica de dimensiones y unicidad de nodos\n",
    "    if x_arr.ndim != 1 or y_arr.ndim != 1 or len(x_arr) != len(y_arr):\n",
    "        raise ValueError(\"x_nodes y y_nodes deben ser arreglos unidimensionales de la misma longitud.\")\n",
    "    if len(np.unique(x_arr)) != len(x_arr):\n",
    "        raise ValueError(\"Los nodos x_i deben ser distintos entre sí.\")\n",
    "\n",
    "    n = len(x_arr) - 1\n",
    "\n",
    "    # Inicializamos la tabla Q de tamaño (n + 1) x (n + 1)\n",
    "    Q = np.zeros((n + 1, n + 1), dtype=float)\n",
    "\n",
    "    # Entrada: primera columna Q_{i,0} = f(x_i) para i = 0, 1, ..., n\n",
    "    Q[:, 0] = y_arr\n",
    "\n",
    "    # Paso 1: Construcción fila por fila\n",
    "    for i in range(1, n + 1):\n",
    "        for j in range(1, i + 1):\n",
    "            numerador = (\n",
    "                (x_eval - x_arr[i - j]) * Q[i, j - 1]\n",
    "                - (x_eval - x_arr[i]) * Q[i - 1, j - 1]\n",
    "            )\n",
    "            denominador = x_arr[i] - x_arr[i - j]\n",
    "            Q[i, j] = numerador / denominador\n",
    "\n",
    "    # Paso 2: Salida (Q) y aproximación final Q_{n,n}\n",
    "    aproximacion_final = float(Q[n, n])\n",
    "    return Q, aproximacion_final\n",
    "\n",
    "print(\"Función neville_algoritmo_3_1 definida correctamente.\")"
   ]
